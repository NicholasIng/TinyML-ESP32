# Data and environments: never commit
data/
venv/
.venv/
*.zip

# Model files: never commit
*.h5
*.keras
*.tflite
*.pb
saved_model/
models/
checkpoints/
*.npy
*.npz

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Editors / OS
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db

# PlatformIO / ESP-IDF builds
firmware/**/.pio/
firmware/**/build/

# Generated firmware constants (from the model): never commit
firmware/generated/
# ESP-IDF config generated by PlatformIO (sdkconfig.defaults is committed)
firmware/**/sdkconfig.*
!firmware/**/sdkconfig.defaults
firmware/**/dependencies.lock
# Components downloaded by the ESP-IDF component manager
firmware/**/managed_components/
